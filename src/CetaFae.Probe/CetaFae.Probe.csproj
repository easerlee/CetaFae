<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CetaFae.Probe</AssemblyName>
    <Version>0.2.0-preview.28</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>CetaFae</Product>
    <Description>Whale interaction and selected-window guidance preview</Description>
    <RootNamespace>CetaFae.Probe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../jingxi.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../CetaFae.Plugins/CetaFae.Plugins.csproj" />
    <EmbeddedResource Include="../../jingxi.ico" LogicalName="CetaFae.jingxi.ico" />
    <Resource Include="Art/Whale/*.png" />
    <Resource Include="Art/Whale/motion.json" />
    <Resource Include="Art/Whale/drop-motion.json" />
    <Resource Include="Art/Whale/droplet.svg" />
    <Content Include="../../plugins/**/*.json" Link="plugins/%(RecursiveDir)%(Filename)%(Extension)"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
